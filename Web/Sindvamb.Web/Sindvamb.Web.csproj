<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Locales\en.json" />
    <EmbeddedResource Include="Locales\zh.json" />
    <EmbeddedResource Include="Locales\pt-BR.json" />
  </ItemGroup>
  <ItemGroup>
	  <PackageReference Include="Blazorise" Version="1.7.6" />
	  <PackageReference Include="Blazorise.Bootstrap" Version="1.7.6" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.4" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.4" PrivateAssets="all" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Authentication" Version="9.0.4" />
	  <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="9.0.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Sindvamb.Web.Shared\Sindvamb.Web.Shared.csproj" />
  </ItemGroup>
</Project>