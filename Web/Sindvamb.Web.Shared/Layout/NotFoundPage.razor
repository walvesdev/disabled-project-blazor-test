@page "/{*Path}"
@attribute [AllowAnonymous]

@attribute [TabItemOption(Text = "Não Encontrado")]

<div style="max-height: 600px;" class="d-flex justify-content-center vh-100 align-items-center text-center overflow-hidden">
    <div style="height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <img style="max-width: 500px;" src="./img/logo-colorido.png" alt="">
        <h3 style="position: relative;top: -50px;font-size: 1.4rem;">
            Recurso não encontrado: <br>
            @* Route: @Path *@
        </h3>
    </div>
</div>


@code {
    [Parameter]
    public string Path { get; set; }
}