@using BootstrapBlazor.Components

<DropdownWidget class="px-3 d-none d-sm-block">
    <DropdownWidgetItem Icon="fa-regular fa-envelope" BadgeNumber="4" HeaderColor="Color.Success" BadgeColor="Color.Success">
        <HeaderTemplate>
            <span>Você tem 4 mensagens não lidas</span>
        </HeaderTemplate>
        <BodyTemplate>

            <div style="width: 250px;">
                @for (var index = 0; index < 4; index++)
                {
                    <a class="dropdown-item d-flex align-items-center" href="#" @onclick:preventDefault>
                        <div style="width: 40px; height: 40px;">
                            <Avatar Url="img\avatars\150-1.jpg" IsCircle="true" Size="Size.Small" />
                        </div>
                        <div class="ms-2 w-100">
                            <div class="d-flex position-relative justify-content-between w-100">
                                <div class="flex-fill">Teste @index</div>
                                <small><i class="fa fa-clock-o"></i> @(4 + index) mins</small>
                            </div>
                            <div class="text-truncate">Notificação @index</div>
                        </div>
                    </a>
                }
            </div>

        </BodyTemplate>
        <FooterTemplate>
            <a href="#" @onclick:preventDefault>Ver todas as mensagens</a>
        </FooterTemplate>
    </DropdownWidgetItem>
    <DropdownWidgetItem Icon="fa-regular fa-bell" BadgeNumber="10" HeaderColor="Color.Warning" BadgeColor="Color.Warning">
        <HeaderTemplate>
            <span>Você tem 10 notificações não lidas</span>
        </HeaderTemplate>
        <BodyTemplate>

            <div style="width: 250px;">

                @for (var index = 0; index < 10; index++)
                {
                    <a class="dropdown-item d-flex align-items-center" href="#" @onclick:preventDefault>
                        <i class="fa fa-users text-primary"></i>
                        <div class="ms-2">5 novos membros se juntaram</div>
                    </a>
                }

            </div>

        </BodyTemplate>
        <FooterTemplate>
            <a href="#" @onclick:preventDefault>Ver todas as notificações</a>
        </FooterTemplate>
    </DropdownWidgetItem>
    <DropdownWidgetItem Icon="fa-regular fa-flag" BadgeNumber="9" HeaderColor="Color.Danger" BadgeColor="Color.Danger">
        <HeaderTemplate>
            <span>Você tem 3 tarefas</span>
        </HeaderTemplate>
        <BodyTemplate>

            <div style="width: 250px;">

                <a href="#" class="dropdown-item" @onclick:preventDefault>
                    <div class="d-flex">
                        <div class="flex-fill pe-5">Tarefa 1</div>
                        <small>20%</small>
                    </div>
                    <Progress IsAnimated="true" IsStriped="true" Value="20" Color="Color.Primary"></Progress>
                </a>
                <a href="#" class="dropdown-item" @onclick:preventDefault>
                    <div class="d-flex">
                        <div class="flex-fill pe-5">Tarefa 2</div>
                        <small>40%</small>
                    </div>
                    <Progress Value="40" Color="Color.Success"></Progress>
                </a>
                <a href="#" class="dropdown-item" @onclick:preventDefault>
                    <div class="d-flex">
                        <div class="flex-fill pe-5">Tarefa 3</div>
                        <small>60%</small>
                    </div>
                    <Progress Value="60" Color="Color.Danger"></Progress>
                </a>
            
            </div>

        </BodyTemplate>
        <FooterTemplate>
            <a href="#" @onclick:preventDefault>Ver todas as tarefas</a>
        </FooterTemplate>
    </DropdownWidgetItem>
</DropdownWidget>
