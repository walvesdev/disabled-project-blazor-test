@using BootstrapBlazor.Components
@inherits LayoutComponentBase

<BootstrapBlazorRoot EnableErrorLogger="true" ShowToast="true" ToastTitle="Erro ao processar requisição">
    <ErrorLogger ShowToast="true" ToastTitle="Erro ao Processar Requisição!">
        @if (ShowPage)
        {
            <TopBar/>
            <NavBar/>
            <ModalSearch/>

            @Body

            <AppFooter/>
            @* <Copyright /> *@

            <!-- Back to Top -->
            <a href="https://wa.me/5561999432019?text=Tenho%20interesse%20em%20saber%20como%20me%20credenciar"
               target="_blank" class="btn btn-lg-square rounded-circle whatsapp">
                <img src="./img/whatsapp.png" style="width: 60px;"/>
            </a>
            <a class="btn bg-secondary btn-lg-square rounded-circle back-to-top">
                <i class="fa fa-arrow-up"></i>
            </a>
        }
        else
        {
            <AppSpinner/>
        }
        
    </ErrorLogger>
</BootstrapBlazorRoot>

@code
{
