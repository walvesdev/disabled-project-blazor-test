    // [CascadingParameter] private Task<AuthenticationState>? authenticationState { get; set; }

    public bool ShowPage { get; set; } = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ShowPage = true;
            
        }
    }

