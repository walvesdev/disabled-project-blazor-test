@using BootstrapBlazor.Components
@inherits LayoutComponentBase

<BootstrapBlazorRoot>
     <CascadingAuthenticationState>
                <AuthorizeView>

                    <Authorized>

                        <Layout ShowGotoTop="true" ShowCollapseBar="true" ShowFooter="@ShowFooter" SideWidth="0"
                                IsPage="true" IsFullSide="@IsFullSide" IsFixedHeader="@IsFixedHeader"
                                IsFixedFooter="@IsFixedFooter"
                                TabDefaultUrl="/home" UseTabSet="@UseTabSet"
                                AdditionalAssemblies="new[] { GetType().Assembly }"
                                Menus="@Menus" class="@Theme">
                            <Header>
                                <div class="flex-fill d-sm-none">
                                </div>
                                <span class="ms-3 flex-sm-fill d-none d-sm-block"
                                      style="color:white; font-weight:bold;">Sindvamb</span>

                                @if (AppServices.IsAdmin() || AppServices.IsMaster())
                                {
                                    <Widget></Widget>
                                }

                                <Logout ImageUrl="@AvatarUrl" DisplayName="@UserName" class="logout-box">
                                    <HeaderTemplate>
                                        @if (!AvatarUrl.IsNullOrWhiteSpace())
                                        {
                                            <div class="d-flex justify-content-center">
                                                <Avatar Url="@AvatarUrl" Size="Size.ExtraLarge" style="width: 90px;"
                                                        IsCircle="true"></Avatar>
                                            </div>
                                        }
                                        <div class="logout-custom-header">
                                            Bem Vindo(a) ao Sindvamb
                                        </div>
                                    </HeaderTemplate>
                                    <LinkTemplate>
                                        <a href="/account-manager"><i class="fa-solid fa-suitcase"></i>Minha Conta</a>
                                        <a><i class="fa-solid fa-cog"></i>Configurações</a>
                                        <a><i class="fa-solid fa-bell"></i>Notificações
                                            <span
                                                class="badge badge-pill badge-success"></span></a>
                                        <a href="/Account/Logout"><i class="fa-solid fa-door"></i>Sair</a>
                                        @* <LogoutLink  /> *@
                                    </LinkTemplate>
                                </Logout>
                            </Header>
                            <Side>
                                <div class="layout-banner">
                                    <img class="layout-logo" src="favicon.png"/>
                                    <div class="layout-title">
                                        <span>Sindvamb</span>
                                    </div>
                                </div>
                            </Side>

                            <Main>


                                @Body


                            </Main>

                            <Footer>
                                <div class="text-center flex-fill">
                                    <a class="page-layout-demo-footer-link"
                                       target="_blank">Sindvamb @DateTime.UtcNow.ToString("yyyy")</a>
                                </div>
                            </Footer>

                            <NotFound>
                                <NotFoundPage/>
                            </NotFound>

                        </Layout>
                    </Authorized>

                    <NotAuthorized>
                        <Login/>
                    </NotAuthorized>

                </AuthorizeView>
            </CascadingAuthenticationState>
</BootstrapBlazorRoot>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>
