@using BootstrapBlazor.Components

<ValidateForm Model="@Model" OnValidSubmit="OnValidSubmit">
    <DataAnnotationsValidator />
    <Row>

        <InputPassword DisplayText="Nova Senha" @bind-Value="@Model.Password" PlaceHolder="Nova Senha" ErrorFor="() => Model.Password" />
        <InputPassword DisplayText="Confirme a Senha" @bind-Value="@Model.ConfirmPassword" PlaceHolder="Confirme a Senha" ErrorFor="() => Model.ConfirmPassword" />

    </Row>
    <Stack IsRow="true" Justify="StackJustifyContent.End" class="gap-3 mt-3">
        <Button Color="Color.Secondary" ButtonStyle="ButtonStyle.None" Text="Cancelar" OnClick="CloseDialg" />
        <Button Color="Color.Primary" ButtonStyle="ButtonStyle.None" ButtonType="ButtonType.Submit" Icon="save" Text="Confirmar" />
    </Stack>
</ValidateForm>

@code {

    [Parameter] public Action OnCloseAsync { get; set; }

    [Parameter] public UpdatePasswordDTO Model { get; set; } = new();

    private async Task OnValidSubmit(EditContext context)
    {
        if (context.Validate())
        {
            await CloseDialg();
        }
    }

    protected async Task CloseDialg()
    {
        OnCloseAsync?.Invoke();
        
    }

}
