@code {
    [Parameter] public int ProductCategoryId { get; set; }


    public Guid OperRequestCategoryId { get; set; }

    [Inject] public IProductCategoryService ProductCategoryService { get; set; }

    public List<ProductCategoryDTO> ProductCategoryList { get; set; } = new();

    public string GetUserName(AuthenticationState context)
    {
        return context.User?.Claims?.FirstOrDefault(p => p.Type.Contains("CustomerType"))?.Value ?? context.User?.Claims?.FirstOrDefault(p => p.Type.Contains("role"))?.Value;
    }

    public async Task GetAllProductCategory()
    {
        ProductCategoryList = await ProductCategoryService.GetAllProductCategory();

        OperRequestCategoryId = ProductCategoryList.FirstOrDefault(c => c.Code.Equals("SAV")).Id;
    }
}
