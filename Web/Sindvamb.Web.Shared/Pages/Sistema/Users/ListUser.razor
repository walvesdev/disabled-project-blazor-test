@page "/users"
@namespace Sindvamb.Web.Shared.Pages.Sistema.Users
@inherits ListComponentBase<UserDTO, IUserService>
@attribute [Authorize]
@* @attribute [AuthorizeRoles(AuthRole.ADMIN)] *@
@* @attribute [Authorize(Roles = "admin,moderator")] *@
@using BootstrapBlazor.Components
<AppAuthorizeView Roles="@AuthRole.ADMIN_MASTER_SUPPORT">

    <Tab IsCard="true">
        <TabItem Text="Usuários">


            <DisplayTable TItem="UserDTO" ShowTable="ShowTable" IsLoading="IsLoading" ShowButtomAdd="true" OnAdd=@(() => AddRowTemplate<AddEditUser>("Adicionar Usuário"))>
                <Table ShowLoading="false" TItem="UserDTO"
                       RenderMode="TableRenderMode.Table"
                       IsPagination="true"
                       TableSize="TableSize.Normal"
                       OnQueryAsync="@OnQueryAsync"
                       PageItemsSource="PageItemsSource"
                       IsStriped="true"
                       IsBordered="true">
                    <TableColumns>
                        <TableColumn @bind-Field="@context.Name" Text="Nome" Align="Alignment.Left" Sortable="true" Filterable="true" />
                        <TableColumn @bind-Field="@context.CpfCnpj" Text="CPF" Align="Alignment.Left" Sortable="true" Filterable="true">
                            <Template Context="value">
                                @Formaters.FormatCpfCnpj(value.Row.CpfCnpj)
                            </Template>
                        </TableColumn>
                        <TableColumn @bind-Field="@context.Email" Text="Email" Align="Alignment.Left" Sortable="true" Filterable="true" />
                        <TableColumn @bind-Field="@context.UserStatus.Description" Text="Status" Align="Alignment.Left" Sortable="true" Filterable="true" />
                        <TableColumn @bind-Field="@context.Id" Align="Alignment.Center" Text="Ações" Width="150">
                            <Template Context="value">

                                <div class="w-100">
                                    <a class="btn btn-action" title="Aprovar"
                                       @onclick=@(() => EditRowTemplate<AddEditUser>("Editar Uduário", value.Row)) @onclick:stopPropagation="true">
                                        <i class="fa-regular fa-pen-to-square text-warning"></i>
                                    </a>
                                    <button class="btn btn-action" title="Bloquear"
                                            @onclick=@(() => GridDeleteButtonClick(value.Row))
                                            @onclick:stopPropagation="true">
                                        <i class="fa-duotone fa-solid fa-trash-can text-danger"></i>
                                    </button>
                                </div>

                            </Template>
                        </TableColumn>
                    </TableColumns>
                </Table>
            </DisplayTable>

        </TabItem>
        <TabItem Text="Contatos">
            <ListContact></ListContact>
        </TabItem>
    </Tab>

</AppAuthorizeView>

