@page "/contact"
@inherits ListComponentBase<ContactDTO, IContactService>
@attribute [TabItemOption(Text = "Contato")]
@attribute [Authorize]
@using BootstrapBlazor.Components
<AppAuthorizeView Roles="@AuthRole.ADMIN_MASTER_SUPPORT">

    <DisplayTable TItem="ContactDTO" ShowTable="ShowTable" IsLoading="IsLoading" ShowButtomAdd="false">
        <Table ShowLoading="false" TItem="ContactDTO"
               RenderMode="TableRenderMode.Table"
               IsPagination="true"
               TableSize="TableSize.Normal"
               OnQueryAsync="@OnQueryAsync"
               PageItemsSource="PageItemsSource"
               IsStriped="true"
               IsBordered="true">
            <TableColumns>
                <TableColumn @bind-Field="@context.Name" Text="Nome" Align="Alignment.Left"
                              Sortable="true" Filterable="true"  DefaultSortOrder="SortOrder.Asc" />
                <TableColumn @bind-Field="@context.CpfCnpj" Text="CPF" Align="Alignment.Left"
                              Sortable="true" Filterable="true" >
                    <Template Context="value">
                        @Formaters.FormatCpfCnpj(value.Row.CpfCnpj)
                    </Template>
                </TableColumn>
                <TableColumn @bind-Field="@context.Address.AddressLine1" Text="Endereço" Align="Alignment.Left"
                              Sortable="true" Filterable="true"  />
                <TableColumn @bind-Field="@context.Address" Align="Alignment.Center" Text="Ações" Width="150">
                    <Template Context="value">

                        <div class="w-100">
                        @* <a class="btn btn-action" title="Aprovar" *@
                        @*    @onclick="@(e => Approve(value.Row))"> *@
                        @*     <i class="i fi-rr-check-circle"></i> *@
                        @* </a> *@
                        @* <a class="btn btn-action" title="Bloquear" *@
                        @*    @onclick="@(e => Deny(value.Row))"> *@
                        @*     <i class="fi fi-rr-circle-x"></i> *@
                        @* </a> *@
                            <a class="btn btn-action" title="Visualisar">
                                <i class="far fa-eye text-secondary"></i>
                            </a>
                        </div>

                    </Template>
                </TableColumn>
            </TableColumns>
        </Table>
    </DisplayTable>

</AppAuthorizeView>


