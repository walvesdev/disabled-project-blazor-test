       @*  <GroupBox Title="Usuários Online" class="containercol-6 my-5">
            <Row ItemsPerRow="ItemsPerRow.One" class="gap-3 py-5">
                <Table ShowLoading="false" TItem="DynamicObject" DynamicContext="DataTableDynamicContext"
                       IsBordered="true"
                       IsStriped="true"
                       SetRowClassFormatter="SetRowClassFormatter"></Table>
            </Row>
