        <GroupBox Title="Acessos ao Site" class="containercol-6 my-5">
            <Row ItemsPerRow="ItemsPerRow.One" class="gap-3 py-5">
                <Table ShowLoading="false" TItem="DynamicObject" DynamicContext="AllDataTableDynamicContext"
