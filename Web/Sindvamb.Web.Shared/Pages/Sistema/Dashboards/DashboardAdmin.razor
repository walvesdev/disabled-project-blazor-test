</AppAuthorizeView>


@code {

    public DateTime DataNascimento { get; set; }

    public bool ShowPage { get; set; } = false;

    [Inject] public DialogService DialogService { get; set; }

    [Parameter] public Guid ErrorId { get; set; }

    [Inject][NotNull] private IConnectionService? ConnectionService { get; set; }

    [Inject][NotNull] private IAccessControlService? AccessControlService { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? authenticationState { get; set; }

    [Inject][NotNull] private WebClientService? WebClientService { get; set; }

    private DynamicObjectContext? DataTableDynamicContext { get; set; }

    private DynamicObjectContext? AllDataTableDynamicContext { get; set; }

    public AccessControlDTO AccessControlDTO { get; set; } = new();

    public List<AccessControlDTO> AccessControList { get; set; } = new();

    private readonly DataTable _table = new();

    private readonly DataTable _tableByDatabase = new();

    private CancellationTokenSource? _cancellationTokenSource;

    private string? _clientId;

    public string UserName { get; set; } = "Visitante";

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (firstRender)
        {
