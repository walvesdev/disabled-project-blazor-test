                        <p>@AccessControList.Count()</p>
                    </div>
                    <div class="card-registro-body">
                        <p>Acessos ao Site</p>
                    </div>
                </div>
            </div>
          @*   <div style="width: 330px;">
                <div class="card-tratamento">
                    <div class="card-tratamento-title">
                        <p>@ConnectionService.Connections.Count</p>
                    </div>
                    <div class="card-tratamento-body">
                        <p>Usuários Online</p>
                    </div>
                </div>
            </div *@>@*
                <div style="width: 330px;">
                    <div class="card-resposta">
                        <div class="card-resposta-title">
                            <p>@DemandasResposta.Count</p>
                        </div>
                        <div class="card-resposta-body">
