@page "/customer-type"
@namespace Sindvamb.Web.Shared.Pages.Sistema.CustomerTypes
@inherits ListComponentBase<CustomerTypeDTO, ICustomerTypeService>
@inject ICustomerTypeService CustomerTypeService
@attribute [Authorize]
@using BootstrapBlazor.Components

<AppAuthorizeView Roles="@AuthRole.ADMIN_MASTER_SUPPORT">

    <DisplayTable TItem="CustomerTypeDTO" ShowTable="ShowTable" IsLoading="IsLoading" OnAdd="() => AddRowType(CustomerTypeService.Create)">
        <Table ShowLoading="false" TItem="CustomerTypeDTO"
               RenderMode="TableRenderMode.Table"
               IsPagination="true"
               TableSize="TableSize.Normal"
               OnQueryAsync="@OnQueryAsync"
               PageItemsSource="PageItemsSource"
               IsStriped="true"
               IsBordered="true">
            <TableColumns>
                <TableColumn Text="Código" @bind-Field="@context.Code" Align="Alignment.Left"  Sortable="true" Filterable="true"
                               DefaultSortOrder="SortOrder.Asc" />
                <TableColumn Text="Descrição" @bind-Field="@context.Description" Align="Alignment.Left"  Sortable="true" Filterable="true"
                              />
                <TableColumn @bind-Field="@context.Id" Align="Alignment.Center" Text="Ações" Width="150">
                    <Template Context="value">

                        <div class="w-100">
                            <a class="btn btn-action" title="Aprovar"
                               @onclick=@(() => EditRowType(value.Row, CustomerTypeService.Update)) @onclick:stopPropagation="true">
                                <i class="fa-regular fa-pen-to-square text-warning"></i>
                            </a>
                            <button class="btn btn-action" title="Excluir"
                                    @onclick=@(() => GridDeleteButtonClick(value.Row))
                                    @onclick:stopPropagation="true">
                                <i class="fa-duotone fa-solid fa-trash-can text-danger"></i>
                            </button>
                        </div>

                    </Template>
                </TableColumn>
            </TableColumns>
        </Table>
    </DisplayTable>

</AppAuthorizeView>

@code {
    private string codigo;
    private string name;

}