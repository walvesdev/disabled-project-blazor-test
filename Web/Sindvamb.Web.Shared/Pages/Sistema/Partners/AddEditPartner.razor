@page "/edit-partner"
@page "/edit-partner/{Id:guid}"
@namespace Sindvamb.Web.Shared.Pages.Sistema.Partners
@inherits EditComponentBase<PartnerDTO, IPartnerService, Guid>
@attribute [Authorize]
@using BootstrapBlazor.Components
<AppAuthorizeView Roles="@AuthRole.ADMIN_MASTER_SUPPORT">

    <div class="mx-3">
        <ValidateForm Model="@Item" OnValidSubmit="@(ev => FormSubmit(ev, "partner"))">
            <div class="row">

                <div class="mb-3">
                    <Switch DisplayText="Cliente Ativo?" @bind-Value="@Item.Enabled" class="ml-3" />
                </div>
                <div class="mb-3">
                    <BootstrapInput Type DisplayText="Nome" @bind-Value="@Item.Name" placeholder="Insira seu nome" />
                </div>
                <div class="mb-3">
                    <BootstrapInput DisplayText="CPF" @bind-Value="@Item.CpfCnpj" id="CpfCnpj" placeholder="Insira seu CPF ou CNPJ" Formatter="Formaters.FormatCpfCnpj" />
                </div>
                <div class="mb-3">
                    <BootstrapInput DisplayText="Email" @bind-Value="@Item.Email" id="Email" placeholder="Insira seu Email" />
                </div>

            </div>
            <div class="d-flex gap-3 col w-100 justify-content-end align-items-end" style="margin-top:1rem;">
                <Button Color="Color.Secondary" ButtonStyle="ButtonStyle.None" Text="Cancelar" OnClick="CloseDialg" />
                <Button Color="Color.Primary" ButtonStyle="ButtonStyle.None" ButtonType="ButtonType.Submit" Icon="save" Text="Confirmar" />
            </div>
        </ValidateForm>
    </div>

</AppAuthorizeView>