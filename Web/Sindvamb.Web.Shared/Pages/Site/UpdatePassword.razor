@page "/atualizar-senha/{CpfCnpj}/{SecurityCode}"
@layout SiteLayout
@inject IUserService UserService
@inject NavigationManagerService NavManager
@inherits AppComponentBase
@using BootstrapBlazor.Components

@if (!IsLoading && !User.Name.IsNullOrWhiteSpace())
{
    <div class="container d-flex align-items-center justify-content-center w-100 my-5 h-100">
        <Card>
            <HeaderTemplate>
                <h5 class="pt-2">@User.Name por favor altere sua senha.</h5>
            </HeaderTemplate>

            <BodyTemplate>
                <ValidateForm @ref="Form" Model="@Model" style="width: 100%" OnValidSubmit="OnValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="d-flex col flex-wrap w-100">

                        <div class="form-group mt-2 col-md-6 px-2">

                            <InputPassword DisplayText="Nova Senha" @bind-Value="@Model.Password" PlaceHolder="Senha" ErrorFor="() => Model.Password" />
                        </div>

                        <div class="form-group mt-2 col-md-6 px-2">
                            <InputPassword DisplayText="Nova Senha" @bind-Value="@Model.ConfirmPassword" PlaceHolder="Confirme a senha" ErrorFor="() => Model.ConfirmPassword" />

                        </div>

                        <div class="d-flex  w-100 justify-content-end px-3 mt-3">

                            <Button Color="Color.Primary" ButtonType="ButtonType.Submit" Text="Confirmar" />

                        </div>

                    </div>

                </ValidateForm>
            </BodyTemplate>
        </Card>
    </div>
}


@code {

    [Parameter] public string CpfCnpj { get; set; }

    [Parameter] public string SecurityCode { get; set; }

    [Inject] public SwalService SwalService { get; set; }

    public ValidateForm Form { get; set; }

    public UserDTO User { get; set; } = new();

    public readonly ChangePasswordModel Model = new();

    protected override async void OnParametersSet()
    {
        try
        {
            ToggleLoading();
            await InvokeAsync(StateHasChanged);

            var customer = await UserService.GetByCpfCnpj(CpfCnpj);

            User = customer?.User;

            ToggleLoading();
            await InvokeAsync(StateHasChanged);

            if (User.IsNull())
            {
                await SwalService.Show(new SwalOption()
                    {
                        Category = SwalCategory.Warning,
                        Title = "Atenção!",
                        Content = "Usuário não encontrado!",
                    });

                await NavManager.NavigateTo("/");
            }
        }
        catch
        {
        }
    }

    public async Task OnValidSubmit(EditContext ctx)
    {
        if (!Model.Password.Equals(Model.ConfirmPassword))
        {
            Form.ShowAllInvalidResult = true;
            Form.SetError(nameof(Model.ConfirmPassword), "As senhas precisam ser iguais!");
            
            return;
        }

        ToggleLoading();
        await InvokeAsync(StateHasChanged);

        Model.SecurityCode = SecurityCode;
        Model.CpfCnpj = CpfCnpj;

        var changed = await UserService.UpdatePassword(Model);

        ToggleLoading();
        await InvokeAsync(StateHasChanged);

        if (changed)
        {
            var redirectToLogin = await SwalService.ShowModal(new SwalOption()
                {
                    Category = SwalCategory.Success,
                    Title = "Feito!",
                    Content = "Senha alterada com sucesso, gostaria de ser redirecionado para àrea de login?",
                });

            if (redirectToLogin)
            {
                await RedirectToLogin();
            }
            else
            {
                await RedirectToHome();
            }
        }
        else
        {
            await SwalService.Show(new SwalOption()
                {
                    Category = SwalCategory.Success,
                    Title = "Atenção!",
                    Content = "A senha não foi alterada, por favor contate o suporte!",
                    OnConfirmAsync = RedirectToHome
                });
        }
    }

    public async Task RedirectToLogin()
    {
        await NavManager.NavigateTo("/Account/Login");
    }

    public async Task RedirectToHome()
    {
        await NavManager.NavigateTo("/");
    }
}