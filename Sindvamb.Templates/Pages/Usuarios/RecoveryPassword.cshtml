@using RazorLight
@using Sindvamb.Templates.Pages.Shared
@namespace Sindvamb.Templates.Pages.Demandas
@inherits TemplatePage<Sindvamb.Templates.Pages.Usuarios.RecoveryPassword>



<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap"
          rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', Arial, sans-serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
        }

        .logo {
            width: 200px;
            float: left;
            margin-top: 8px;
        }

        .email-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #ffffff;
            padding: 20px;
            border: 1px solid #dddddd;
        }

        .header {
            background-color: #0056b3;
            color: #ffffff !important;
            padding: 10px;
            text-align: center;
            height: 80px;
            border-radius: 15px;
            margin-bottom: 50px;
        }

        .content {
            text-align: center;
            font-size: 1rem;
        }

        .content-user {
            margin: 30px 35px;
            text-align: left;
            color: #000;
        }

        .button {
            display: block;
            width: 200px;
            margin: 50px auto;
            padding: 10px;
            background-color: #007bff;
            color: #ffffff !important;
            text-align: center;
            text-decoration: none;
            border-radius: 5px;
        }

        .footer {
            text-align: center;
            color: #888888;
            font-size: 12px;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <div class="email-container">
        <div class="content">

            @{
                await IncludeAsync("Sindvamb.Templates.Pages.Shared.Header", new Header { StaticFileServerUrl = Model.StaticFileServerUrl, CssClassName = Model.CssClassName });
            }


            <h3>Olá! @Model.Nome</h3>

            <div class="content-user">

                <p style="margin: 0 0 30px 0;"> Segue o link para Recuperar sua senha, <a href="@Model.FrontEndUrl/@Model.Url"> disponível aqui</a>. </p>


                <p style="margin: 0">
                    <b>Se você não solicitou alteração por favor desconsidere esse email.</b>
                </p>

                <p>Equipe Sindvamb-DF</p>

            </div>


            <p>Clique no link abaixo em seu navegador para acessar o nosso sistema.</p>

            <p><a href="https://www.sindvamb.com.br">https://www.sindvamb.com.br</a></p>

        </div>

        <div class="footer">
            <p>Não responda, e-mail automático.</p>
        </div>
    </div>
</body>
</html>