@using RazorLight
@namespace Sindvamb.Templates.Pages.Demandas
@inherits TemplatePage<Sindvamb.Templates.Pages.Demandas.OrderCreate>




<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width"/>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@200;400;500;600;700&display=swap" rel="stylesheet">
</head>
<body style="font-family: 'Poppins', sans-serif !important; margin: auto">

<div style="height: 800px; border: #ccc solid 1px;color: #000; line-height: 1.5; font-size: 0.9rem; width: 90%; background-color: #FFFFFF !important;">

    <div style="margin: 0 0 30px 0; 
                height: 60px;
                background: #6AC39C !important;
                position: relative;
                top: -30px;
                color: #FFF;">
        <p style="width: 100%; text-align: center; padding-top: 10px; font-size: 30px; font-weight: 700;;">Nova demanda</p>
    </div>

    <div style="padding: 25px;">
        <p style="margin: 0 0 30px 0;">
            <b> Olá @Model.BusinnesPartnerName </b>
        </p>


        <p style="margin: 0 0 30px 0;">Solicito seu apoio para atuar na nova demanda (#@Model.OrderProtocol), <a href="@Model.FrontEndUrl/edit-order/@Model.OrderId"> disponível aqui</a>. </p>


        <p style="margin: 0">
            <b>Resumo da demanda:</b>
        </p>
        <p style="margin: 0">Unidade: @Model.PartnerUnitName</p>
        <p style="margin: 0">VP: @Model.ProductAreaName</p>
        <p style="margin: 0">Nome Cliente: @Model.ClientName</p>
        <p style="margin: 0">E-mail do Cliente: @Model.ClientEmail</p>
        <p style="margin: 0">Tipo de demanda: @Model.OrderTypeName</p>
        <p style="margin: 0">Descrição da demanda: @Model.OrderDescription</p>
        <p style="margin: 0">Área de Gente, Gestão e Cultura relacionada à demanda: @Model.ProductCategoryName</p>
    </div>

</div>
</body>

</html>