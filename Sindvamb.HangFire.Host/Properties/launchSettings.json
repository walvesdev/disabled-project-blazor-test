{
  "profiles": {
    "Sindvamb.HangFire.Host": {
      "commandName": "Project",
      "launchUrl": "dashboard",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "applicationUrl": "http://localhost:5004;https://localhost:5005"
    },
    "Docker": {
      "commandName": "Docker",
      "launchBrowser": false,
      "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/dashboard",
      "environmentVariables": {
        "ASPNETCORE_HTTP_PORTS": "5004",
        "ASPNETCORE_HTTPS_PORTS": "5005"
      },
      "publishAllPorts": true,
      "useSSL": true
    }
  },
  "$schema": "http://json.schemastore.org/launchsettings.json"
}