<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Configurations>Debug;Release;Production</Configurations>
		<Platforms>AnyCPU</Platforms>
		<NuGetAudit>false</NuGetAudit>
	</PropertyGroup>
	
	<ItemGroup>
	  <Content Include="libwkhtmltox.dll">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="libwkhtmltox.dylib">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	  <Content Include="libwkhtmltox.so">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </Content>
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="FreeSpire.PDF" Version="10.2.0" />
		<PackageReference Include="QRCoder" Version="1.6.0" />
		<PackageReference Include="DinkToPdf" Version="1.0.8" />
		<PackageReference Include="System.Drawing.Common" Version="9.0.4" />
		<PackageReference Include="System.IO.FileSystem" Version="4.3.0" />
		<PackageReference Include="System.IO.FileSystem.Primitives" Version="4.3.0" />
		<PackageReference Include="System.Net.Http" Version="4.3.4" />
		<PackageReference Include="System.Net.Primitives" Version="4.3.1" />
		<PackageReference Include="System.Text.Encoding.Extensions" Version="4.3.0" />
	</ItemGroup>
	
	<ItemGroup>
	  <ProjectReference Include="..\Sindvamb.Repository\Sindvamb.Repository.csproj" />
	  <ProjectReference Include="..\Sindvamb.Utils\Sindvamb.Utils.csproj" />
	</ItemGroup>
</Project>